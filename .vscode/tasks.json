{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SmartSpend: Build Java server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\build.ps1"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "SmartSpend: Run server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\run.ps1"
      ],
      "dependsOn": "SmartSpend: Build Java server",
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
